<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>SM IPTV BD</title>
  <meta name="description" content="SM IPTV BD - IPTV service information and channel updates.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      min-height: 100vh;
      color: #fff;
      background:
        radial-gradient(circle at top left, rgba(0, 255, 170, .15), transparent 35%),
        radial-gradient(circle at bottom right, rgba(0, 120, 255, .18), transparent 35%),
        #05070d;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      overflow-x: hidden;
    }

    .container {
      width: 100%;
      max-width: 900px;
    }

    /* Glass Card */
    .card {
      position: relative;
      overflow: hidden;
      padding: 45px 30px;
      border-radius: 28px;
      text-align: center;

      background: rgba(255, 255, 255, 0.055);
      border: 1px solid rgba(255, 255, 255, 0.10);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      box-shadow:
        0 25px 80px rgba(0, 0, 0, .55),
        inset 0 1px 0 rgba(255,255,255,.08);
    }

    /* Glow */
    .glow {
      position: absolute;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: #00ffae;
      filter: blur(120px);
      opacity: .12;
      top: -100px;
      left: -80px;
      pointer-events: none;
    }

    .glow2 {
      position: absolute;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: #0077ff;
      filter: blur(120px);
      opacity: .13;
      right: -80px;
      bottom: -100px;
      pointer-events: none;
    }

    /* Logo */
    .logo {
      width: 85px;
      height: 85px;
      margin: 0 auto 22px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 24px;
      font-size: 30px;
      font-weight: 900;
      letter-spacing: -2px;

      background: linear-gradient(135deg, #00ffae, #0077ff);
      color: #05070d;

      box-shadow:
        0 12px 35px rgba(0, 255, 174, .22);
    }

    .badge {
      display: inline-block;
      padding: 7px 14px;
      margin-bottom: 15px;
      border-radius: 50px;

      font-size: 12px;
      font-weight: bold;
      letter-spacing: 1px;
      text-transform: uppercase;

      color: #00ffae;
      background: rgba(0,255,174,.08);
      border: 1px solid rgba(0,255,174,.18);
    }

    h1 {
      font-size: clamp(34px, 7vw, 60px);
      line-height: 1;
      margin-bottom: 16px;
      letter-spacing: -2px;
    }

    h1 span {
      background: linear-gradient(90deg, #00ffae, #00aaff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .subtitle {
      max-width: 650px;
      margin: 0 auto;
      color: #aeb7c7;
      line-height: 1.7;
      font-size: 16px;
    }

    /* Info Boxes */
    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin: 32px 0;
    }

    .feature {
      padding: 20px 12px;
      border-radius: 18px;

      background: rgba(255,255,255,.045);
      border: 1px solid rgba(255,255,255,.07);
    }

    .feature-icon {
      font-size: 25px;
      margin-bottom: 9px;
    }

    .feature strong {
      display: block;
      font-size: 15px;
      margin-bottom: 5px;
    }

    .feature small {
      color: #8f9aad;
      font-size: 12px;
    }

    /* Channel Button */
    .channel {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;

      width: 100%;
      max-width: 430px;
      padding: 17px 25px;

      border-radius: 15px;
      text-decoration: none;

      font-size: 16px;
      font-weight: 800;
      color: #fff;

      background: linear-gradient(135deg, #168cff, #0066dd);

      box-shadow:
        0 12px 30px rgba(0, 110, 255, .25);

      transition: .25s ease;
    }

    .channel:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 40px rgba(0, 110, 255, .35);
    }

    .telegram {
      font-size: 23px;
    }

    .notice {
      margin-top: 22px;
      color: #747f92;
      font-size: 12px;
      line-height: 1.6;
    }

    footer {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.07);
      color: #687386;
      font-size: 12px;
    }

    footer b {
      color: #9aa5b7;
    }

    /* Mobile */
    @media (max-width: 650px) {
      body {
        padding: 14px;
      }

      .card {
        padding: 35px 18px;
        border-radius: 23px;
      }

      .features {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .feature {
        padding: 15px;
        display: flex;
        align-items: center;
        text-align: left;
        gap: 13px;
      }

      .feature-icon {
        margin: 0;
      }

      .feature strong {
        margin-bottom: 2px;
      }

      .logo {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        font-size: 25px;
      }
    }
  </style>
</head>

<body>

  <main class="container">

    <section class="card">

      <div class="glow"></div>
      <div class="glow2"></div>

      <div class="logo">SM</div>

      <div class="badge">● IPTV SERVICE</div>

      <h1>
        Welcome to <span>SM IPTV BD</span>
      </h1>

      <p class="subtitle">
        Welcome to our IPTV platform. Get the latest channel updates,
        service information and important announcements through our
        official Telegram channel.
      </p>

      <div class="features">

        <div class="feature">
          <div class="feature-icon">📺</div>
          <div>
            <strong>IPTV Channels</strong>
            <small>Channel information & updates</small>
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon">⚡</div>
          <div>
            <strong>Regular Updates</strong>
            <small>Latest service information</small>
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon">🔔</div>
          <div>
            <strong>Stay Connected</strong>
            <small>Get important announcements</small>
          </div>
        </div>

      </div>

      <a
        class="channel"
        href="https://t.me/sm_iptv_bd"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="telegram">✈</span>
        Join Our Telegram Channel
      </a>

      <p class="notice">
        Follow our Telegram channel to receive the latest updates and
        channel-related information.
      </p>

      <footer>
        © 2026 <b>SM IPTV BD</b> · All Rights Reserved
      </footer>

    </section>

  </main>

</body>
</html>
