<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Server Offline</title>
    <style>
        :root {
            --bg: #050508;
            --red-glow: #ff1a1a;
            --red-deep: #cc0000;
            --red-soft: #ff4444;
            --text-primary: #e8e8e8;
            --text-secondary: #9a9a9a;
            --divider-glow: #ff3333;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg);
            font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'JetBrains Mono', 'Consolas', 'Courier New', monospace;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            height: 100vh;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* Subtle grid background for dashboard feel */
        .bg-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.012) 1px, transparent 1px);
            background-size: 48px 48px;
            background-position: center center;
            animation: gridDrift 20s linear infinite;
        }

        @keyframes gridDrift {
            0% {
                background-position: 0 0;
            }
            100% {
                background-position: 48px 48px;
            }
        }

        /* Ambient red glow orb in background */
        .ambient-glow {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 20, 20, 0.06) 0%, rgba(255, 0, 0, 0.02) 30%, transparent 70%);
            pointer-events: none;
            z-index: 0;
            animation: ambientPulse 4s ease-in-out infinite;
        }

        @keyframes ambientPulse {
            0%,
            100% {
                transform: translate(-50%, -50%) scale(1);
                opacity: 0.7;
            }
            50% {
                transform: translate(-50%, -50%) scale(1.25);
                opacity: 1;
            }
        }

        /* Second smaller ambient glow */
        .ambient-glow-secondary {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255, 40, 40, 0.1) 0%, rgba(255, 0, 0, 0.03) 40%, transparent 70%);
            pointer-events: none;
            z-index: 0;
            animation: ambientPulseSecondary 3s ease-in-out infinite;
        }

        @keyframes ambientPulseSecondary {
            0%,
            100% {
                transform: translate(-50%, -50%) scale(1);
                opacity: 0.5;
            }
            50% {
                transform: translate(-50%, -50%) scale(1.4);
                opacity: 0.9;
            }
        }

        /* Main container */
        .container {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 20px;
            animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Status badge - top */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 7px 18px;
            border: 1px solid rgba(255, 50, 50, 0.35);
            border-radius: 50px;
            background: rgba(255, 0, 0, 0.06);
            margin-bottom: 28px;
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            animation: badgeGlow 2.5s ease-in-out infinite;
        }

        @keyframes badgeGlow {
            0%,
            100% {
                box-shadow: 0 0 8px rgba(255, 30, 30, 0.15), 0 0 20px rgba(255, 0, 0, 0.05);
            }
            50% {
                box-shadow: 0 0 16px rgba(255, 30, 30, 0.3), 0 0 35px rgba(255, 0, 0, 0.12);
            }
        }

        .status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background-color: #ff1a1a;
            position: relative;
            animation: dotPulse 1.3s ease-in-out infinite;
        }

        .status-dot::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 1.5px solid rgba(255, 30, 30, 0.5);
            animation: dotRipple 1.3s ease-in-out infinite;
        }

        @keyframes dotPulse {
            0%,
            100% {
                background-color: #ff1a1a;
                box-shadow: 0 0 6px #ff1a1a, 0 0 14px rgba(255, 0, 0, 0.7);
            }
            50% {
                background-color: #ff5555;
                box-shadow: 0 0 12px #ff4444, 0 0 28px rgba(255, 0, 0, 0.9);
            }
        }

        @keyframes dotRipple {
            0%,
            100% {
                width: 22px;
                height: 22px;
                opacity: 0.7;
                border-color: rgba(255, 30, 30, 0.5);
            }
            50% {
                width: 34px;
                height: 34px;
                opacity: 0.15;
                border-color: rgba(255, 30, 30, 0.15);
            }
        }

        .status-text {
            color: #ff3b3b;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-family: 'Inter', 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
            white-space: nowrap;
        }

        /* Main heading */
        .heading {
            font-size: clamp(1.6rem, 5vw, 2.2rem);
            font-weight: 700;
            color: #d4d4d4;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            margin-bottom: 16px;
            font-family: 'Inter', 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
            text-shadow: 0 0 30px rgba(255, 255, 255, 0.08);
            animation: headingGlow 4s ease-in-out infinite;
        }

        @keyframes headingGlow {
            0%,
            100% {
                text-shadow: 0 0 30px rgba(255, 255, 255, 0.08);
            }
            50% {
                text-shadow: 0 0 45px rgba(255, 255, 255, 0.16), 0 0 8px rgba(255, 60, 60, 0.2);
            }
        }

        /* Glowing divider */
        .divider-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            max-width: 260px;
            width: 70%;
        }

        .divider {
            width: 100%;
            height: 1px;
            background: linear-gradient(90deg,
                    transparent 0%,
                    rgba(255, 40, 40, 0.1) 10%,
                    rgba(255, 40, 40, 0.7) 35%,
                    rgba(255, 60, 60, 1) 50%,
                    rgba(255, 40, 40, 0.7) 65%,
                    rgba(255, 40, 40, 0.1) 90%,
                    transparent 100%);
            box-shadow:
                0 0 8px rgba(255, 30, 30, 0.8),
                0 0 20px rgba(255, 0, 0, 0.4),
                0 0 40px rgba(255, 0, 0, 0.2);
            animation: dividerShimmer 3s ease-in-out infinite;
            border-radius: 1px;
        }

        @keyframes dividerShimmer {
            0%,
            100% {
                box-shadow:
                    0 0 8px rgba(255, 30, 30, 0.8),
                    0 0 20px rgba(255, 0, 0, 0.4),
                    0 0 40px rgba(255, 0, 0, 0.2);
            }
            50% {
                box-shadow:
                    0 0 14px rgba(255, 40, 40, 1),
                    0 0 30px rgba(255, 0, 0, 0.6),
                    0 0 55px rgba(255, 0, 0, 0.3);
            }
        }

        /* Subtitle */
        .subtitle {
            color: #7a7a7a;
            font-size: clamp(0.8rem, 1.8vw, 0.95rem);
            font-weight: 400;
            letter-spacing: 0.04em;
            line-height: 1.5;
            max-width: 480px;
            margin: 0 auto;
            font-family: 'Inter', 'SF Pro Display', 'Segoe UI', system-ui, sans-serif;
        }

        /* Subtle scan line effect */
        .scanlines {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 2;
            background: repeating-linear-gradient(0deg,
                    transparent,
                    transparent 2px,
                    rgba(0, 0, 0, 0.03) 2px,
                    rgba(0, 0, 0, 0.03) 4px);
        }

        /* Corner accents for dashboard feel */
        .corner-accent {
            position: fixed;
            pointer-events: none;
            z-index: 0;
            opacity: 0.25;
        }
        .corner-accent.top-left {
            top: 24px;
            left: 24px;
            width: 40px;
            height: 40px;
            border-top: 1px solid rgba(255, 50, 50, 0.4);
            border-left: 1px solid rgba(255, 50, 50, 0.4);
        }
        .corner-accent.top-right {
            top: 24px;
            right: 24px;
            width: 40px;
            height: 40px;
            border-top: 1px solid rgba(255, 50, 50, 0.4);
            border-right: 1px solid rgba(255, 50, 50, 0.4);
        }
        .corner-accent.bottom-left {
            bottom: 24px;
            left: 24px;
            width: 40px;
            height: 40px;
            border-bottom: 1px solid rgba(255, 50, 50, 0.4);
            border-left: 1px solid rgba(255, 50, 50, 0.4);
        }
        .corner-accent.bottom-right {
            bottom: 24px;
            right: 24px;
            width: 40px;
            height: 40px;
            border-bottom: 1px solid rgba(255, 50, 50, 0.4);
            border-right: 1px solid rgba(255, 50, 50, 0.4);
        }

        /* Responsive adjustments */
        @media (max-width: 600px) {
            .bg-grid {
                background-size: 32px 32px;
            }
            @keyframes gridDrift {
                0% {
                    background-position: 0 0;
                }
                100% {
                    background-position: 32px 32px;
                }
            }
            .container {
                padding: 16px;
            }
            .status-badge {
                padding: 6px 14px;
                gap: 7px;
                margin-bottom: 22px;
            }
            .status-text {
                font-size: 0.7rem;
                letter-spacing: 0.1em;
            }
            .heading {
                font-size: 1.4rem;
                letter-spacing: 0.2em;
                margin-bottom: 12px;
            }
            .divider-wrapper {
                margin: 0 auto 16px;
                max-width: 200px;
            }
            .subtitle {
                font-size: 0.8rem;
            }
            .corner-accent {
                opacity: 0.18;
            }
            .corner-accent.top-left,
            .corner-accent.top-right,
            .corner-accent.bottom-left,
            .corner-accent.bottom-right {
                width: 28px;
                height: 28px;
            }
            .corner-accent.top-left {
                top: 14px;
                left: 14px;
            }
            .corner-accent.top-right {
                top: 14px;
                right: 14px;
            }
            .corner-accent.bottom-left {
                bottom: 14px;
                left: 14px;
            }
            .corner-accent.bottom-right {
                bottom: 14px;
                right: 14px;
            }
            .ambient-glow {
                width: 300px;
                height: 300px;
            }
            .ambient-glow-secondary {
                width: 160px;
                height: 160px;
            }
        }

        @media (min-width: 1200px) {
            .heading {
                font-size: 2rem;
                letter-spacing: 0.3em;
            }
            .subtitle {
                font-size: 1rem;
                max-width: 520px;
            }
            .divider-wrapper {
                max-width: 300px;
            }
        }
    </style>
</head>
<body>

    <!-- Background grid pattern -->
    <div class="bg-grid"></div>

    <!-- Ambient glow orbs -->
    <div class="ambient-glow"></div>
    <div class="ambient-glow-secondary"></div>

    <!-- Subtle scanlines overlay -->
    <div class="scanlines"></div>

    <!-- Corner accents for dashboard premium look -->
    <div class="corner-accent top-left"></div>
    <div class="corner-accent top-right"></div>
    <div class="corner-accent bottom-left"></div>
    <div class="corner-accent bottom-right"></div>

    <!-- Main content -->
    <div class="container">
        <!-- Status badge -->
        <div class="status-badge">
            <span class="status-dot"></span>
            <span class="status-text">● SERVER OFFLINE</span>
        </div>

        <!-- Main heading -->
        <h1 class="heading">SERVER IS OFFLINE</h1>

        <!-- Glowing divider -->
        <div class="divider-wrapper">
            <div class="divider"></div>
        </div>

        <!-- Subtitle -->
        <p class="subtitle">The server is temporarily unavailable. Please try again later.</p>
    </div>

</body>
</html>
